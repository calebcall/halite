# Copy this file to `.env` and fill in real values.
# `docker compose` auto-loads `.env` from this directory — no shell exports needed.

# ---- Database --------------------------------------------------------------
# For compose.yml (Postgres profile) — leave this as-is:
DATABASE_URL=postgresql+asyncpg://halite:halite@db:5432/halite
# For compose.sqlite.yml (homelab profile) — uncomment instead:
# DATABASE_URL=sqlite+aiosqlite:////data/halite.db

# ---- Sessions --------------------------------------------------------------
# Generate one with:  ./scripts/gen-bootstrap-secret.sh
COOKIE_SECRET=replace-me-with-output-of-scripts-gen-bootstrap-secret.sh
SESSION_TTL_MINUTES=480

# Cookie Secure flag.
#   false → cookie sent on plain HTTP (use for local docker testing at http://localhost:8080)
#   true  → cookie sent only over HTTPS (use in production behind a TLS proxy)
COOKIE_SECURE=false

# ---- Inventory background scheduler --------------------------------------
# When > 0, the backend runs a periodic ``refresh_packages(target='*')`` every
# N minutes. 0 disables it (manual refreshes via the UI still work).
INVENTORY_REFRESH_MINUTES=0
# Seconds between process start and the first scheduled refresh. Keep this
# above your healthcheck's grace period so the first refresh doesn't run
# before the salt-master has finished its own startup.
INVENTORY_REFRESH_INITIAL_DELAY_S=30

# ---- Salt-API (used in later plans) ---------------------------------------
# SALT_API_URL=https://salt-master:8000
# SALT_API_VERIFY=true
# SALT_API_EAUTH=pam
# SALT_API_USERNAME=halite-service
# SALT_API_PASSWORD=

# ---- Bootstrap admin (only honored when no users exist) -------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme

# ---- Networking ------------------------------------------------------------
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
TRUSTED_PROXIES=

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
