# Database (pick one)
DATABASE_URL=postgresql+asyncpg://halite:halite@db:5432/halite
# DATABASE_URL=sqlite+aiosqlite:///./data/halite.db

# Sessions
COOKIE_SECRET=replace-me-with-output-of-scripts-gen-bootstrap-secret.sh
SESSION_TTL_MINUTES=480
COOKIE_SECURE=true

# Salt-API (used in later plans)
# SALT_API_URL=https://salt-master:8000
# SALT_API_VERIFY=true
# SALT_API_EAUTH=pam
# SALT_API_USERNAME=halite-service
# SALT_API_PASSWORD=

# Bootstrap admin (only honored when no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme

# Networking
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
TRUSTED_PROXIES=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
